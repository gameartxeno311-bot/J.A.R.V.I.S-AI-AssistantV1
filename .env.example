NODE_ENV=development
PORT=8787
DATABASE_PATH=./data/jarvis.sqlite
# Add provider credentials only on the server. Never expose these to the frontend.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_TIMEOUT_MS=120000
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=cedar
OPENAI_TTS_TIMEOUT_MS=120000
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TTS_MODEL=canopylabs/orpheus-v1-english
GROQ_TTS_VOICE=troy
LLM_API_KEY=
LLM_MODEL=
STT_PROVIDER=none
STT_API_KEY=
TTS_PROVIDER=none
TTS_API_KEY=

# Local filesystem roots the assistant may inspect. Comma-separated absolute paths.
ALLOWED_FILESYSTEM_ROOTS=./workspace
