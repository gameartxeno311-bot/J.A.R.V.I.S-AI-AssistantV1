NODE_ENV=development
PORT=8787
DATABASE_PATH=./data/jarvis.sqlite
# Add provider credentials only on the server. Never expose these to the frontend.
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=
STT_PROVIDER=none
STT_API_KEY=
TTS_PROVIDER=none
TTS_API_KEY=

# Local filesystem roots the assistant may inspect. Comma-separated absolute paths.
ALLOWED_FILESYSTEM_ROOTS=./workspace
